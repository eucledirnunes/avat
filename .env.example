# Segredos das Edge Functions (NÃO vão para o git). Configure com:
#   supabase secrets set --env-file .env --project-ref wuwhzoxowotvktyrxxmp
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são injetados pelo Supabase.

HEYGEN_API_KEY=
HEYGEN_VOICE_ID=

# Chave simples enviada no header x-app-key (protege as funções enquanto não há login).
APP_ACCESS_KEY=

# Opcional: organização usada no modo sem login.
# DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
